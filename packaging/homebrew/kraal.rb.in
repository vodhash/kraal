# kraal's formula, put in the tap by kraal's release workflow (packaging/homebrew/publish.sh).
class Kraal < Formula
  desc "Terminal workspaces for coding agents and SSH fleets"
  homepage "https://github.com/vodhash/kraal"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/vodhash/kraal/releases/download/v@VERSION@/kraal-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256 aarch64-apple-darwin@"
    end
    on_intel do
      url "https://github.com/vodhash/kraal/releases/download/v@VERSION@/kraal-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256 x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/vodhash/kraal/releases/download/v@VERSION@/kraal-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256 aarch64-unknown-linux-musl@"
    end
    on_intel do
      url "https://github.com/vodhash/kraal/releases/download/v@VERSION@/kraal-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256 x86_64-unknown-linux-musl@"
    end
  end

  def install
    bin.install "kraal"
  end

  test do
    assert_match "kraal #{version}", shell_output("#{bin}/kraal --version")
  end
end
